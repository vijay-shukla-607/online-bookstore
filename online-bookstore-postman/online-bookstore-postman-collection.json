    {
      "name": "02 - Customer Authentication",
      "description": "Register a customer then login. Registration only creates CUSTOMER accounts.",
      "item": [
        {
          "name": "Register customer (email configurable)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Default email is unique per run; change it in collection variables if already registered.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"Customer123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"Status is 201 Created or 409 if this email already exists\", function () {",
                  "  pm.expect([201,409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) pm.collectionVariables.set(\"customerToken\", data.token);",
                  "  if (data.email) pm.collectionVariables.set(\"customerEmail\", data.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login customer (captures customerToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"Customer123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"Login succeeded\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set(\"customerToken\", data.token);",
                  "if (data.email) pm.collectionVariables.set(\"customerEmail\", data.email);",
                  "pm.test(\"Customer role is CUSTOMER\", function () { pm.expect(data.role).to.eql(\"CUSTOMER\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Invalid credentials rejected\",()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with invalid email (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
