    {
      "name": "05 - Admin Book Management",
      "description": "Admin credentials are seeded for local development. Login request captures adminToken. Run admin login first.",
      "item": [
        {
          "name": "Login seeded admin (captures adminToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Local-only seed credentials from the README. Do not use outside local development.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bookstore.local\",\n  \"password\": \"ChangeMe123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"Admin login succeeded\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set(\"adminToken\", data.token);",
                  "pm.test(\"Role is ADMIN\", function () { pm.expect(data.role).to.eql(\"ADMIN\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create book (captures managedBookId)",
          "request": {
            "method": "POST",
            "header": [
              {
