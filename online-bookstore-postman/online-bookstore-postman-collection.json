  "item": [
    {
      "name": "01 - Public Books",
      "description": "Run these first to verify seeded sample data and public catalogue APIs.",
      "item": [
        {
          "name": "List all books (also captures first bookId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "Expected 200. Fresh H2 startup seeds three books."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"Book list returned\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "if (Array.isArray(data) && data.length && data[0].id) pm.collectionVariables.set(\"bookId\", String(data[0].id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?search=Java",
