# Local reference only. Do not put real secrets in Git.
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_SECRET
JWT_EXPIRATION_MINUTES=60
APP_CORS_ORIGINS=http://localhost:5173

# For the default local H2 profile, these are not required.
# MySQL profile:
# SPRING_PROFILES_ACTIVE=mysql
# DB_URL=jdbc:mysql://localhost:3306/bookstore?useSSL=true&serverTimezone=UTC
# DB_USERNAME=bookstore_app
# DB_PASSWORD=replace-me
# DDL_AUTO=validate
